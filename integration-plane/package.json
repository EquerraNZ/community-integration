{
  "name": "integration-plane",
  "version": "1.0.0",
  "description": "The Azure integration layer for the Integration Foundation extension: receivers, stagers, senders, and the subscription health check.",
  "private": true,
  "main": "dist/src/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rimraf dist",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@azure/functions": "^4.5.1",
    "@azure/identity": "^4.4.1",
    "@azure/service-bus": "^7.9.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "rimraf": "^5.0.10",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
